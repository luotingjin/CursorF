# TAPD 开放平台应用凭证（在 https://open.tapd.cn 创建应用后获取）
TAPD_CLIENT_ID=your_client_id
TAPD_CLIENT_SECRET=your_client_secret

# 可选：直接使用 Access Token（优先级高于 client_credentials）
# TAPD_ACCESS_TOKEN=your_access_token

# TAPD API 基础地址（默认公有云）
TAPD_API_BASE=https://api.tapd.cn

# 项目 ID（必填）
TAPD_WORKSPACE_ID=10158231

# 可选：测试计划 ID（用于关联需求与用例）
# TAPD_TEST_PLAN_ID=

# 可选：用例创建人（固定填写，A 方案）
TAPD_CREATOR=罗婷斤

# LLM 配置（generator=llm 时使用，兼容 OpenAI API）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
